{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"\u6211\u7684\u7f51\u7ad9\u540d\u79f0"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff01\u8fd9\u91cc\u662f\u6211\u7684\u4e2a\u4eba\u7f51\u7ad9\u3002</p> <p>\u6211\u4f1a\u5728\u8fd9\u91cc\u5206\u4eab\u5b66\u4e60\u8bb0\u5f55\u3001\u8bfe\u7a0b\u7b14\u8bb0\u548c\u751f\u6d3b\u4e2d\u7684\u601d\u8003\u3002\u4ee5\u540e\u53ef\u4ee5\u628a\u8fd9\u6bb5\u6587\u5b57\u66ff\u6362\u6210\u4f60\u7684\u59d3\u540d\u3001\u5174\u8da3\u3001\u7ecf\u5386\u548c\u8054\u7cfb\u65b9\u5f0f\u3002</p>"},{"location":"course/","title":"\u5b66\u4e60\u5185\u5bb9","text":"<p>\u8fd9\u91cc\u8bb0\u5f55\u6211\u7684\u5b66\u4e60\u7b14\u8bb0\u3001\u8bfe\u7a0b\u6574\u7406\u4e0e\u5b9e\u8df5\u5fc3\u5f97\u3002</p>"},{"location":"course/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u793a\u4f8b\u8bfe\u7a0b\uff1a\u5982\u4f55\u5199\u4e00\u7bc7\u5b66\u4e60\u6587\u7ae0</li> </ul>"},{"location":"course/example/","title":"\u793a\u4f8b\u8bfe\u7a0b\uff1a\u5982\u4f55\u5199\u4e00\u7bc7\u5b66\u4e60\u6587\u7ae0","text":"<p>\u8fd9\u662f\u4e00\u6bb5\u6587\u7ae0\u7b80\u4ecb\u3002\u7528\u4e00\u4e24\u53e5\u8bdd\u8bf4\u660e\u8fd9\u7bc7\u6587\u7ae0\u4f1a\u8bb2\u4ec0\u4e48\u3001\u8bfb\u5b8c\u80fd\u5b66\u5230\u4ec0\u4e48\u3002</p>"},{"location":"course/example/#_2","title":"\u5b66\u4e60\u76ee\u6807","text":"<p>\u5b66\u5b8c\u8fd9\u7bc7\u6587\u7ae0\u540e\uff0c\u4f60\u5c06\u80fd\u591f\uff1a</p> <ul> <li>\u7528\u6e05\u6670\u7684\u7ed3\u6784\u6574\u7406\u5b66\u4e60\u7b14\u8bb0\uff1b</li> <li>\u4f7f\u7528\u6807\u9898\u3001\u5217\u8868\u548c\u4ee3\u7801\u5757\uff1b</li> <li>\u5199\u51fa\u7b80\u77ed\u7684\u603b\u7ed3\u3002</li> </ul>"},{"location":"course/example/#_3","title":"\u6b63\u6587","text":"<p>\u4ece\u8fd9\u91cc\u5f00\u59cb\u5199\u8bfe\u7a0b\u5185\u5bb9\u3002\u5efa\u8bae\u6bcf\u4e2a\u4e3b\u9898\u4f7f\u7528\u4e00\u4e2a\u4e8c\u7ea7\u6807\u9898\uff0c\u8f83\u5c0f\u7684\u77e5\u8bc6\u70b9\u53ef\u4ee5\u4f7f\u7528\u4e09\u7ea7\u6807\u9898\u3002</p>"},{"location":"course/example/#_4","title":"\u4e00\u4e2a\u5c0f\u77e5\u8bc6\u70b9","text":"<p>\u666e\u901a\u6587\u5b57\u53ef\u4ee5\u76f4\u63a5\u4e66\u5199\u3002\u9700\u8981\u5f3a\u8c03\u7684\u5185\u5bb9\u53ef\u4ee5\u4f7f\u7528 \u7c97\u4f53\uff0c\u8865\u5145\u8bf4\u660e\u53ef\u4ee5\u4f7f\u7528 \u659c\u4f53\u3002</p>"},{"location":"course/example/#_5","title":"\u4ee3\u7801\u793a\u4f8b","text":"<p>\u4ee3\u7801\u524d\u540e\u5404\u653e\u4e09\u4e2a\u53cd\u5f15\u53f7\uff0c\u5e76\u5728\u5f00\u5934\u6ce8\u660e\u8bed\u8a00\uff1a</p> <pre><code>message = \"\u4f60\u597d\uff0cMkDocs\uff01\"\nprint(message)\n</code></pre>"},{"location":"course/example/#_6","title":"\u5c0f\u7ed3","text":"<p>\u5728\u8fd9\u91cc\u7528\u51e0\u53e5\u8bdd\u56de\u987e\u6587\u7ae0\u7684\u91cd\u70b9\u3002\u4ee5\u540e\u65b0\u589e\u6587\u7ae0\u65f6\uff0c\u53ef\u4ee5\u590d\u5236\u8fd9\u4e2a\u6587\u4ef6\uff0c\u518d\u4fee\u6539\u6807\u9898\u548c\u6b63\u6587\u3002</p>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u8fd9\u91cc\u6536\u85cf\u670b\u53cb\u4eec\u548c\u6211\u5e38\u8bbf\u95ee\u7684\u7f51\u7ad9\u3002</p> <ul> <li>\u793a\u4f8b\u670b\u53cb\u7684\u7f51\u7ad9 \u2014 \u4e00\u53e5\u8bdd\u4ecb\u7ecd\u8fd9\u4e2a\u7f51\u7ad9\u3002</li> <li>MkDocs \u5b98\u65b9\u7f51\u7ad9 \u2014 MkDocs \u4f7f\u7528\u6587\u6863\u3002</li> </ul>"}]}